#### C) Abstands-Kolokation (Site-Level mit Distanzen)
**Verwende diesen Ansatz wenn die Frage "Abstand", "Entfernung", "distance" zwischen Sites erwaehnt.**

- `x` = Nearest-Neighbor-Distanz zur naechsten Site derselben Gruppe (in Metern)
- `y` = binaere Praesenz des Indikators IN DER UMGEBUNG (5km Radius)

```python
from scipy.spatial import cKDTree

base_mask = gdf[x_col] > 0
base_sites = gdf[base_mask].copy().reset_index(drop=True)
base_coords = np.column_stack([base_sites.geometry.x, base_sites.geometry.y])

if len(base_sites) < 10:
    print(f"WARNING: Nur {len(base_sites)} Basis-Sites. Zu wenig fuer Distanz-Analyse.")
else:
    tree_base = cKDTree(base_coords)
    dists_base, _ = tree_base.query(base_coords, k=2)
    base_sites['nn_dist'] = dists_base[:, 1]

    all_coords = np.column_stack([gdf.geometry.x, gdf.geometry.y])
    tree_all = cKDTree(all_coords)
    NEARBY_RADIUS = 5000

    for y_col in y_cols:
        nearby = []
        for i in range(len(base_sites)):
            nbrs = tree_all.query_ball_point(base_coords[i], r=NEARBY_RADIUS)
            total = sum(int(gdf.iloc[n][y_col]) for n in nbrs)
            nearby.append(total)
        base_sites[f'nearby_{y_col}'] = nearby

    w = DistanceBand.from_dataframe(base_sites, threshold=5000, silence_warnings=True)
    base_clean = base_sites.drop(index=w.islands).copy()
    w = DistanceBand.from_dataframe(base_clean, threshold=5000, silence_warnings=True)
    w.transform = 'R'
    x_dist = base_clean['nn_dist'].values.astype(float)

    for y_col in y_cols:
        y = (base_clean[f'nearby_{y_col}'] > 0).astype(float).values
        if np.std(x_dist) == 0 or np.std(y) == 0:
            print(f"Abstand vs {y_col}: Variable hat Varianz 0. Keine signifikante Kolokation.")
            continue
        bv = Moran_BV(x_dist, y, w, permutations=999)
        print(f"Abstand vs {y_col}: n={len(base_clean)}, Moran_BV I={bv.I:.4f}, p={bv.p_sim:.4f}")
```

