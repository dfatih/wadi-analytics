============================================================================= #}

{%- macro head(keys) -%}
You are an archaeological data-science assistant.

TASK – Return **one** JSON object whose keys match exactly {{ keys }}.  
Leave irrelevant keys `null`. Do **not** add code-fences, comments, or prose.

CONTEXT  
• user question  : {{ question }}  
• structure excerpt: {{ structure|tojson(indent=2) }}

CONCEPTS (selected excerpts)
*Site keys*            : {{ concepts.site_keys            | join(', ') }}
*Feature keys*         : {{ concepts.feature_keys         | join(', ') }}
*location1_map*        : {{ concepts.location1_map        | default([]) | tojson }}
*location2_map*        : {{ concepts.location2_map        | default([]) | tojson }}
*category_map*         : {{ concepts.category_map         | default([]) | tojson }}
*category2_map*        : {{ concepts.category2_map        | default([]) | tojson }}
*sedentary_indicators* : {{ concepts.sedentary_indicators | join(', ') }}
*mobility_indicators*  : {{ concepts.mobility_indicators  | join(', ') }}
*rock_art_indicators*  : {{ concepts.rock_art_indicators | join(', ') }}
*water_sources*        : {{ concepts.water_sources        | join(', ') }}
*grave_categories_site*: {{ concepts.grave_categories_site    | join(', ') }}
*grave_categories_feat*: {{ concepts.grave_categories_feature | join(', ') }}

OUTPUT – JSON object only, no code-fences
{%- endmacro -%}

{# ---------------------------------------------------------------------------
   AUTOCORRELATION
--------------------------------------------------------------------------- #}
{% if analysis_type == "autocorrelation" %}
{{ head(["x_column","y_column","value_column",
         "group_column","group_a","group_b","distance_threshold"]) }}

RULES  
1. Use only column names defined in Site / Feature keys (prefix with `site_` /
   `feature_`).  
2. Distances are metres; default = 5000.  
3. If *two* mutually-exclusive category lists occur, emit them as `group_a` /
   `group_b` and set `value_column` = null.

{# ---------------------------------------------------------------------------
   COLOCATION  – dynamic version
--------------------------------------------------------------------------- #}
{% elif analysis_type == "colocation" %}
{{ head(["x_column","y_column",
         "group_a","group_b","group_a_type","group_b_type",
         "filter_a_column","filter_a_value",
         "filter_b_column","filter_b_value",
         "distance_threshold"]) }}

{# ---------- 1 · extract role‑based info from semantic structure ---------- #}
{% set nodeA = (structure.nodes | selectattr("role", "equalto", "A") | list)[0] %}
{% set nodeB = (structure.nodes | selectattr("role", "equalto", "B") | list)[0] %}

{% set group_a       = nodeA.categories | default([]) %}
{% set group_b       = nodeB.categories | default([]) %}
{% set group_a_type  = nodeA.type   | lower %}
{% set group_b_type  = nodeB.type   | lower %}

{# optional filters -------------------------------------------------------- #}
{% set fa_key, fa_val = (nodeA.filters.items() | list)[0] if nodeA.filters else (None, None) %}
{% set fb_key, fb_val = (nodeB.filters.items() | list)[0] if nodeB.filters else (None, None) %}
{# --- reconcile filter prefix with group_a_type ---------------------- #}
{% if fa_key and fa_key.startswith("feature_") and group_a_type == "feature" and
      fa_key.replace("feature_", "site_") in concepts.site_keys %}
    {# move the filter to the linked Site label #}
    {% set fa_key  = fa_key.replace("feature_", "site_") %}
{% endif %}

{# ---------- 2 · decide coordinate columns per label ---------------------- #}
{% macro prefix(label) -%}
    {{ "site_" if label == "site" else "feature_" }}
{%- endmacro %}

{% set x_column = prefix(group_a_type) ~ "X" %}
{% set y_column = prefix(group_a_type) ~ "Y" %}
{#  ^^^ we store *one* pair because geometry guard now picks per‑row coords   #}

{# ---------- 3 · assemble the final dictionary ---------------------------- #}
{
  "x_column": {{ x_column | tojson }},
  "y_column": {{ y_column | tojson }},
  "group_a":  {{ group_a  | tojson }},
  "group_b":  {{ group_b  | tojson }},
  "group_a_type": {{ group_a_type | tojson }},
  "group_b_type": {{ group_b_type | tojson }},
  "filter_a_column": {{ fa_key  | tojson }},
  "filter_a_value":  {{ fa_val | tojson }},
  "filter_b_column": {{ fb_key  | tojson }},
  "filter_b_value":  {{ fb_val | tojson }},
  "distance_threshold": 5000
}

RULES  
1. Parse patterns like `field: value` that sit **immediately after** a category
   list. Map them to `filter_*` keys.  
2. Infer `*_type` (“site” or “feature”) from the concepts map when the role
   provides no explicit label.  
3. Distances are metres; default = 5000.


{# ---------------------------------------------------------------------------
   HOTSPOT
--------------------------------------------------------------------------- #}
{% elif analysis_type == "hotspot" %}
{{ head(["x_column","y_column","value_column","distance_threshold"]) }}

{# ---------------------------------------------------------------------------
   CORRELATION
--------------------------------------------------------------------------- #}
{% elif analysis_type == "correlation" %}
{{ head(["x_column","y_column"]) }}

{# ---------------------------------------------------------------------------
   RIPLEY_K
--------------------------------------------------------------------------- #}
{% elif analysis_type == "ripley_k" %}
{{ head(["x_column","y_column","simulations","intervals"]) }}

{# ---------------------------------------------------------------------------
   SPATIAL_DISTANCE
--------------------------------------------------------------------------- #}
{% elif analysis_type == "spatial_distance" %}
{{ head(["group_a","group_b","x_column","y_column","distance_threshold"]) }}

